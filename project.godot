; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GODOT-AI Vibe Suite"
config/description="Suite de plugins para Godot 4: terreno visual, grama e VFX, controlável por vibecoding via Claude Code no terminal."
run/main_scene="res://demos/demo_hub.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/vibe_core/plugin.cfg", "res://addons/vibe_terrain/plugin.cfg", "res://addons/vibe_grass/plugin.cfg", "res://addons/vibe_vfx/plugin.cfg", "res://addons/vibe_motion/plugin.cfg", "res://addons/vibe_scatter/plugin.cfg")

[rendering]

anti_aliasing/quality/msaa_3d=2
